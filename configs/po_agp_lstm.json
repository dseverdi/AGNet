{
    "model_type":    "lstm",
    "embedding_size": 128,
    "hidden_size":    128,
    "n_glimpses":     1,
    "tanh_exploration": 10.0,
    "temperature":    1.0,

    "epochs":         200,
    "batch_size":     32,
    "lr":             0.0003,
    "train_size":     8000,
    "seed":           1234,
    "epoch_eval_k":   50,
    "checkpoint_dir": "checkpoints/v3/po_agp/lstm_bt",
    "max_grad_norm":  0.5,

    "num_rollouts":   8,
    "alpha":          0.05,
    "preference_loss": "bt",
    "po_debug_stats": true,
    "early_stop_patience": 40,
    "early_stop_min_delta": 0.001,
    "lr_schedule":    "cosine",

    "reward_lambda":       1.0,
    "coverage_threshold":  0.99,
    "tau_penalty":         3.0,
    "cap_coverage":        false,
    "fast_reward":         true,
    "disc_vis_samples":    500,

    "skip_finetune": true
}
